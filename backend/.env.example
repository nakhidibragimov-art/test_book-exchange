DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookexchange"
JWT_SECRET="change-me"
CLIENT_URL="http://localhost:5173"

# SMTP (обов'язково для листів про обмін і відновлення пароля)
# Gmail: увімкніть 2-Step Verification і створіть пароль застосунку на myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=app_password_without_spaces
MAIL_FROM="Book Exchange <your.email@gmail.com>"

# Адмін для seed
